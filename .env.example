# Copy to .env (in the repo root or a project folder) and fill in.
# load_dotenv() searches upward from the script's folder, so a project-level
# .env overrides the root one.

# Models per role, as provider:model (see common/README.md)
LLM_DEFAULT=groq:openai/gpt-oss-20b
LLM_AGENT=groq:openai/gpt-oss-20b
LLM_STRUCTURER=groq:openai/gpt-oss-20b
EMBEDDINGS=ollama:nomic-embed-text

GROQ_API_KEY=
TAVILY_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=

PINECONE_API_KEY=
INDEX_NAME=
